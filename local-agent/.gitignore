# Environment & secrets
.env
.env.local
.env.*.local
.env.*.bak
*.pem
*.key

# Native host EnvironmentFile (generated by make remote-native-env)
deploy/gantry.env

# Downloaded gantry + MCP tool binaries for native deploy
.cache/

# Runtime MCP creds live under data/.config/* (gitignored via data/ below).
# Legacy secrets/* trees kept ignored for one-time `make secrets-migrate`.

# Google OAuth / gws export inputs (optional import source; never commit)
secrets/google/*
!secrets/google/.gitkeep
!secrets/google/.gitignore

# Legacy MCP credential dirs (prefer data/.config/*)
secrets/google-mcp/**
!secrets/google-mcp/.gitkeep
!secrets/google-mcp/.gitignore
!secrets/google-mcp/credentials/
!secrets/google-mcp/credentials/.gitkeep
!secrets/google-mcp/credentials/.gitignore

secrets/strava/*
!secrets/strava/.gitkeep
!secrets/strava/.gitignore

secrets/garmin/*
!secrets/garmin/.gitkeep
!secrets/garmin/.gitignore

secrets/youtube/*
!secrets/youtube/.gitkeep
!secrets/youtube/.gitignore
secrets/ytmusic/*
!secrets/ytmusic/.gitkeep
!secrets/ytmusic/.gitignore

# Scratch HOME used for local garmin CLI smoke tests (never commit)
secrets/garmin_home_tmp/

# Legacy ZeroClaw config tree (kept until cutover is confirmed; then delete)
config/

# Agent persona: commit only *.example.md templates. Live *.md are personal.
persona/*
!persona/*.example.md

# MCP manifest is committed (mcp.toml) — no generated config anymore.

# Data volume (gantry.db: sessions + memory + heartbeat)
data/
!data/.gitkeep

# Docker
.docker/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*.local.*
.idea/

# Temp
tmp/
*.tmp
*.swp
*~
