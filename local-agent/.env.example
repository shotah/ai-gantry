# =============================================================================
# local-agent — a lean, self-hosted assistant on ai-gantry
#   make env          create .env from this file (skips if .env exists)
#   make env-force    overwrite .env from this file
# =============================================================================

# --- Timezone (recommended) --------------------------------------------------
# Docker defaults to UTC. Set an IANA zone so LOCAL_AGENT's clock / cron match you.
# Examples: America/Los_Angeles, America/Denver, America/New_York, Europe/London
TZ=America/Los_Angeles

# --- Gemini (required) -------------------------------------------------------
# https://aistudio.google.com/apikey
# Also powers Google Search via mcp-gemini-google-search (docs/web-search.md).
# Paid / billing-enabled project required for search grounding.
GEMINI_API_KEY=
# Lean default; use gemini-3.5-pro (or similar) if you want more depth.
# Same value is passed to the Google Search MCP (avoid Pro-preview default there).
GEMINI_MODEL=gemini-3.5-flash
# Chat provider swap (any OpenAI-compatible endpoint — xAI, Ollama, …):
# override all three LLM_* and gantry uses them instead of the Gemini keys.
# Search stays on GEMINI_API_KEY either way. See docs/models.md.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=
# LLM_MODEL=grok-4.3

# --- Telegram (required) -----------------------------------------------------
# 1. Talk to @BotFather → /newbot → copy token
# 2. Message your bot, then get your user id via @userinfobot
# Guide: docs/telegram.md
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs (not @usernames).
# Allowlist only — empty allowlist fails boot; there is no pairing flow.
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_ERROR_REPORTING=error  # off|error|warn — expandable DM alerts (native default)

# --- Discord (optional; CHANNEL=discord) -------------------------------------
# Outbound Gateway DMs — docs: ../../docs/discord.md
# CHANNEL=discord
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=

# --- Slack (optional; CHANNEL=slack) -----------------------------------------
# Socket Mode only — docs: ../../docs/slack.md
# CHANNEL=slack
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=

# --- gantry knobs (optional; defaults in shotah/ai-gantry §5.1) ---------------
# LLM_MAX_TOKENS=4096           # completion cap (0 = provider default)
# STREAM_REPLIES=true           # Telegram edit-in-place streaming (default)
# SHOW_THINKING=true            # CoT italics → expandable (default; needs
#                               # STREAM_REPLIES; independent of
#                               # LLM_REASONING_EFFORT — set that to none on
#                               # slow local models so CoT is not generated)
# TOOL_TRACE=compact            # full|compact|off — tool lines in the bubble
#                               # (compact = Making Calls: ✓, ✗ [default];
#                               # full = → name / ✓ timing; off = hide).
#                               # Needs STREAM_REPLIES=true.
# LOG_LEVEL=info
# HISTORY_MAX_MESSAGES=200
# HISTORY_MAX_TOKENS=128000     # estimated (chars/4)
# TOOL_RESULT_MAX_CHARS=6000  # flights/rentals/cars: keep low — results re-prefill each tool iter
# TOOL_MAX_ITERATIONS=10    # tool rounds per turn; a final no-tools call then forces a reply
# SELF_NOTES_ENABLED=true   # agent-writable SELF.md + personality distill on /new
#                           # (auto-off when the persona dir is read-only)
# COALESCE_SETTLE_MS=2000   # quiet ms after a bubble interrupts a running turn
#                           # (lone messages never wait); 0=off
# SPINUP_NOTICE_MS=4000     # "working on it" after this much model silence;
#                           # first turn after start posts at once; 0=off
# MEMORY_ENABLED=true
# MEMORY_BACKEND=builtin        # or mcp:<server-name>
# MEMORY_CONSOLIDATE_MINUTES=30 # 0 = off
# CRON_ENABLED=true
# Spark of life (opt-in; leave SPARK_QTY unset to disable):
# SPARK_QTY=4-6
# SPARK_START_HOUR=6
# SPARK_END_HOUR=21
# SPARK_SKIP_RECENT_MINUTES=60
# SPARK_PROMPT=Generate a short Spark of Life check-in. Keep it under 3 sentences. No tools. Pick one of two angles: (1) A fascinating, hyper-specific lab-energy curiosity — biometric, athletic recovery, focus, or craft. (2) A sharp, dry, or slightly sarcastic observation about tech, outdoor culture, or everyday life. Never use generic dad jokes, two-truths-and-a-lie templates, or canned internet games. Keep it raw, present, and authentic.
# (optional; empty = built-in default. One variant per line — random pick per ping.)
# Capability examples (on by default; /examples on|off in chat; empty or 0 disables pings):
# EXAMPLES_QTY=1-2
# EXAMPLES_START_HOUR=6
# EXAMPLES_END_HOUR=21
# EXAMPLES_QTY=0

# --- Google Workspace MCP (recommended) --------------------------------------
# Go binary: shotah/google-mcp (docs/google-workspace.md).
# Desktop OAuth client; redirect URI: http://localhost:4100/oauth2callback
# After setting these, run: make google-auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=

# --- Strava workout data (optional) ------------------------------------------
# Lets LOCAL_AGENT read your activities (Garmin auto-syncs to Strava) for weekly
# summaries and "get to the gym / rest today" nudges via the strava-mcp tool.
# 1. Create an API app: https://www.strava.com/settings/api
#    (Authorization Callback Domain = localhost)
# 2. Copy the Client ID + Client Secret below.
# 3. Authorize once on a browser PC, then deploy. Guide: docs/strava.md
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Garmin Connect (optional) -----------------------------------------------
# Sleep, Body Battery, HRV, Index scale weight via go-garmin.
# Chat re-auth: /auth garmin → MFA email → /auth garmin <code>
# (creds stay on the box; never paste passwords in chat). Guide: docs/garmin.md
# docs/auth.md
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Optional pin of the release binary (default: latest / image bake):
# GARMIN_MCP_VERSION=v0.1.2

# --- Google Cast / house speakers (optional) ---------------------------------
# Local Chromecast / Nest / DLNA via mcp-beam (static Go, no API keys).
# Guide: docs/cast.md
# mDNS discovery needs host networking on a Linux home server:
# NETWORK_MODE=host
# (default is bridge — fine for Docker Desktop / no Cast)
# Defaults to GitHub latest each build. Pin only to freeze:
# MCP_BEAM_VERSION=v0.0.1
# MCP_BEAM_LOG_LEVEL=info

# --- YouTube (optional) ------------------------------------------------------
# Data API v3 via youtube-go-mcp v1+ (static Go). Guide: docs/youtube.md
# TV/Limited Input OAuth client + make youtube-auth → data/.config/youtube/oauth.json
# Approve as the Google account that owns your YouTube likes/playlists.
# Diagnose: make youtube-whoami / make youtube-probe
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# Legacy _* names still work in the binary; prefer YOUTUBE_* above.
# Defaults to GitHub latest each build. Pin only to freeze:
# YOUTUBE_GO_MCP_VERSION=v1.0.0

# --- Math calculator (optional) ----------------------------------------------
# Arithmetic + unit convert via mcp-go-math (static Go). Guide: docs/math.md
# Pinned by default in the Dockerfile; override only to freeze/advance:
# MCP_GO_MATH_VERSION=v0.0.2

# --- Flights / Google Flights via SerpAPI (optional) --------------------------
# Search + recommend only (no purchase). Guide: docs/flights.md
# SERPAPI_API_KEY=
# FLIGHTS_SEARCH_MCP_VERSION=latest   # or pin v0.0.2 (shotah/flights-search-mcp)

# --- Rentals / long-term residential via RentCast (optional) -----------------
# Apartments & houses — search + listing handoff only (no applications). Guide: docs/rentals.md
# RENTCAST_API_KEY=
# RENTALS_SEARCH_MCP_VERSION=latest   # or pin v0.0.1 (shotah/rentals-search-mcp)

# --- Cars / MarketCheck inventory (optional) ---------------------------------
# Used/new cars — search + listing handoff only (no leads). Guide: docs/cars.md
# MARKETCHECK_API_KEY=
# CARS_SEARCH_MCP_VERSION=latest   # or pin v0.0.1 (shotah/cars-search-mcp)
# MARKETCHECK_USAGE_FILE=/data/marketcheck-usage.json

# --- Image / build (optional) ------------------------------------------------
# Compose builds a thin local image: distroless/static + gantry + MCP tools from
# mcp.toml via `gantry tools-fetch`. Pin tool versions with download_tag there.
# GANTRY_IMAGE = local tag for the built image.
GANTRY_IMAGE=gantry-local-agent:local
# Native release pin (make remote-native-fetch):
# GANTRY_VERSION=v0.0.5

# Host user inside the container (run `id -u` / `id -g` on the server)
GANTRY_UID=1000
GANTRY_GID=1000

# --- Remote Ubuntu deploy (optional) -----------------------------------------
# From Windows: needs OpenSSH Client. Then: make remote-deploy
# Guide: docs/deploy.md
DEPLOY_HOST=
DEPLOY_USER=ubuntu
DEPLOY_PATH=/gantry
DEPLOY_SSH_PORT=22
# Windows example: C:/Users/you/.ssh/id_ed25519
# Linux example:   ~/.ssh/id_ed25519
DEPLOY_SSH_KEY=

# --- Native remote (binary + systemd + Ollama; make remote-native-deploy) ----
# Guide: deploy/README.md
# Point DEPLOY_HOST at the Beelink and DEPLOY_PATH=/opt/gantry
# GANTRY_VERSION=latest
# Ollama chat model written into deploy/gantry.env by `make remote-native-env`.
# Deploy does not regenerate gantry.env — bump this, run remote-native-env, then deploy.
# NATIVE_LLM_MODEL=qwen3.6:35b-a3b
# Optional: skip MCP tools-fetch on deploy-dev (reuse /opt/gantry/bin).
# NATIVE_SKIP_TOOLS=1
