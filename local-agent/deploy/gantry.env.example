# Native host env for /opt/gantry (systemd EnvironmentFile).
# Copy to deploy/gantry.env (gitignored) or let `make remote-native-env` generate it.
# Docs: deploy/README.md · ../docs/models.md

# --- Paths (native layout) ---------------------------------------------------
HOME=/opt/gantry/data
DATA_DIR=/opt/gantry/data
PERSONA_DIR=/opt/gantry/persona
MCP_MANIFEST=/opt/gantry/mcp.toml

# --- Local brain (Ollama) ----------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.6:35b-a3b
# Prompt (persona + tool schemas + history) + completion must fit Ollama's
# context window (see deploy/ollama-gantry.conf); thinking tokens, when
# enabled, count toward this cap.
LLM_MAX_TOKENS=8192
# No CoT by default: thinking tokens decode at full price before any tool
# fires, which is most of the perceived lag. low|medium brings it back (and
# streams to Telegram as an expandable italic blockquote).
LLM_REASONING_EFFORT=none
# Tool results are re-sent on every loop iteration, so this cap multiplies
# prefill cost. 6000 is the native tradeoff (shared default is 16000).
TOOL_RESULT_MAX_CHARS=6000

# --- Channel -----------------------------------------------------------------
CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
STREAM_REPLIES=true
# SHOW_THINKING=true   # default; set false for a quieter bubble
# Tool activity in the bubble: compact (Making Calls: ✓, ✗) | full | off
# TOOL_TRACE=compact
# Multi-bubble quiet window (ms) after a follow-up interrupts a running turn.
# A lone message starts immediately and never waits this out. 0=off.
# COALESCE_SETTLE_MS=2000
# Open the bubble with a "hang on" line while prefill is still silent.
# First turn after a restart posts immediately (known-cold). 0=off.
# SPINUP_NOTICE_MS=4000
# Tee slog ERROR (or WARN+) into the Tim chat as an expandable alert.
# off|error|warn
TELEGRAM_ERROR_REPORTING=error
LOG_LEVEL=info

# --- Timezone / cron ---------------------------------------------------------
TZ=America/Los_Angeles
CRON_TZ=America/Los_Angeles
CRON_ENABLED=true
# Spark of life — opt-in random presence pings (empty SPARK_QTY = off)
# SPARK_QTY=4-6
# SPARK_START_HOUR=6
# SPARK_END_HOUR=21
# SPARK_SKIP_RECENT_MINUTES=15
# SPARK_PROMPT=Tell a short dad joke.\nAsk a silly would-you-rather.\nOne warm check-in sentence.

# --- Gemini (web-search MCP only when that binary is present) ----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- MCP tool credentials (files under data/.config) -------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
WORKSPACE_MCP_CREDENTIALS_DIR=/opt/gantry/data/.config/google-mcp/credentials
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_TOKEN_PATH=/opt/gantry/data/.config/strava/tokens.json
YOUTUBE_OAUTH_PATH=/opt/gantry/data/.config/youtube/oauth.json
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# Flights (SerpAPI) — docs/flights.md
# SERPAPI_API_KEY=
# Rentals (RentCast) — docs/rentals.md
# RENTCAST_API_KEY=
# Cars (MarketCheck) — docs/cars.md
# MARKETCHECK_API_KEY=
# MARKETCHECK_USAGE_FILE=/opt/gantry/data/marketcheck-usage.json
