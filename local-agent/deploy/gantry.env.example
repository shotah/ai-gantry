# Native host env for /opt/gantry (systemd EnvironmentFile).
# Copy to deploy/gantry.env (gitignored) or let `make remote-native-env` generate it.
# Docs: deploy/README.md · ../docs/models.md

# --- Paths (native layout) ---------------------------------------------------
HOME=/opt/gantry/data
DATA_DIR=/opt/gantry/data
PERSONA_DIR=/opt/gantry/persona
MCP_MANIFEST=/opt/gantry/mcp.toml

# --- Local brain (Ollama) ----------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:35b
# Qwen3.5 burns completion budget on thinking unless disabled.
LLM_MAX_TOKENS=16384
LLM_REASONING_EFFORT=none

# --- Channel -----------------------------------------------------------------
CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
STREAM_REPLIES=true
LOG_LEVEL=info

# --- Timezone / cron ---------------------------------------------------------
TZ=America/Los_Angeles
CRON_TZ=America/Los_Angeles
CRON_ENABLED=true

# --- Gemini (web-search MCP only when that binary is present) ----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- MCP tool credentials (files under data/.config) -------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
WORKSPACE_MCP_CREDENTIALS_DIR=/opt/gantry/data/.config/google-mcp/credentials
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_TOKEN_PATH=/opt/gantry/data/.config/strava/tokens.json
YTMUSIC_HEADERS_PATH=/opt/gantry/data/.config/ytmusic/headers.json
