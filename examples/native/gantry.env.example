# Consumer repo — copy to gantry.env (install.sh does this if missing).
# systemd EnvironmentFile for /opt/gantry. See README.md.

# --- Paths -------------------------------------------------------------------
HOME=/opt/gantry/data
DATA_DIR=/opt/gantry/data
PERSONA_DIR=/opt/gantry/persona
MCP_MANIFEST=/opt/gantry/mcp.toml

# --- Local brain (Ollama) ----------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.6:35b-a3b
LLM_MAX_TOKENS=8192
LLM_REASONING_EFFORT=none
TOOL_RESULT_MAX_CHARS=6000

# Cloud LLM instead (then drop Requires=ollama.service from gantry.service):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash

# --- Channel -----------------------------------------------------------------
CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
STREAM_REPLIES=true
LOG_LEVEL=info

# --- Timezone / cron ---------------------------------------------------------
TZ=America/Los_Angeles
CRON_TZ=America/Los_Angeles
CRON_ENABLED=true
# FEEDS_USER_AGENT=feeds-mcp/0.1 (you@example.com)
# X_BEARER_TOKEN=
