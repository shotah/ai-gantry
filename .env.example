# Required — OpenAI-compatible endpoint (Gemini, xAI, Ollama, …)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# LLM_MAX_TOKENS=4096             # completion cap (0 = provider default)
# Tip: LOCAL_AGENT compose maps GEMINI_API_KEY → LLM_API_KEY for you.
# See examples/docker/.env.example

# Channel: telegram (default), discord, slack, or stdio (local REPL)
CHANNEL=telegram

# Required when CHANNEL=telegram — allowlist only, no pairing
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Required when CHANNEL=discord — snowflake user IDs (see docs/discord.md)
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=

# Required when CHANNEL=slack — Socket Mode (see docs/slack.md)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=

# Optional
# PERSONA_DIR=/persona
# DATA_DIR=/data
# MCP_MANIFEST=/etc/gantry/mcp.toml
# HISTORY_MAX_MESSAGES=200
# HISTORY_MAX_TOKENS=128000
# TOOL_RESULT_MAX_CHARS=6000
# TOOL_MAX_ITERATIONS=10     # tool rounds per turn; a final no-tools call then forces a reply
# SELF_NOTES_ENABLED=true    # agent-writable SELF.md + personality distill on /new
#                            # (auto-off when PERSONA_DIR is read-only)
# SHOW_THINKING=true        # CoT italics → expandable (default; needs STREAM_REPLIES)
# TOOL_TRACE=compact        # full|compact|off — tool lines when STREAM_REPLIES=true
# COALESCE_SETTLE_MS=2000   # quiet ms after a bubble interrupts a running turn
#                           # (lone messages never wait); 0=off
# SPINUP_NOTICE_MS=4000     # "working on it" after this much model silence;
#                           # first turn after start posts at once; 0=off
# TOOL_SCHEMA_MAX_TOKENS=0
# MEMORY_ENABLED=true
# MEMORY_BACKEND=builtin
# MEMORY_CONSOLIDATE_MINUTES=30
# CRON_ENABLED=true
# CRON_TZ=America/Los_Angeles
# CRON_MAX_JOBS=50
# CRON_TICK_SECONDS=15
# Spark of life (opt-in; empty SPARK_QTY = off): random joke/check-in pings
# SPARK_QTY=4-6
# SPARK_START_HOUR=6
# SPARK_END_HOUR=21
# SPARK_SKIP_RECENT_MINUTES=60
# SPARK_PROMPT=Generate a short Spark of Life check-in. Keep it under 3 sentences. No tools. Pick one of two angles: (1) A fascinating, hyper-specific lab-energy curiosity — biometric, athletic recovery, focus, or craft. (2) A sharp, dry, or slightly sarcastic observation about tech, outdoor culture, or everyday life. Never use generic dad jokes, two-truths-and-a-lie templates, or canned internet games. Keep it raw, present, and authentic.
# Capability examples / training wheels (on by default; empty or 0 = no proactive pings; /examples still works):
# EXAMPLES_QTY=1-2
# EXAMPLES_START_HOUR=6
# EXAMPLES_END_HOUR=21
# EXAMPLES_SKIP_RECENT_MINUTES=60
# EXAMPLES_QTY=0
# STREAM_REPLIES=true
# LOG_LEVEL=info
