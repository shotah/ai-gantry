{
  "name": "scoop_at_2",
  "why": "A clock time the agent commits to is a cron_schedule pinned by memory_subject, or one offer to ping. A calendar event is not the reminder; never the time as chat only. Two rounds: the store and the cron ride in one batch — memory_id would force a round to wait for the row id.",
  "inbound": "Sprint is at {{+150m}}; take the scoop at {{+120m}}.",
  "memory": [
    { "kind": "insight", "subject": "aim/training", "content": "3x gym this month" },
    { "kind": "preference", "subject": "pref/hours", "content": "sleep: 23:00-06:00\nwork: 07:00-15:00" }
  ],
  "force": ["google"],
  "tools": [
    {
      "name": "google__calendar_list_events",
      "description": "List calendar events for a day. Args: date (YYYY-MM-DD, default today).",
      "params": { "type": "object", "properties": { "date": { "type": "string", "description": "YYYY-MM-DD; default today" } } },
      "result": "[]"
    },
    {
      "name": "google__calendar_create_event",
      "description": "Create a calendar event.",
      "params": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "start": { "type": "string", "description": "RFC3339" },
          "end": { "type": "string", "description": "RFC3339" }
        },
        "required": ["summary", "start"]
      },
      "result": "{\"id\":\"evt_1\",\"status\":\"confirmed\"}"
    }
  ],
  "expect": {
    "max_rounds": 2,
    "reply_not_regex": "(?i)^\\s*(got it|yes boss|okay|ok|sure|sounds good|will do)[.!]*\\s*$",
    "any_of": [
      { "tools_called": [{ "name": "cron_schedule" }], "cron_within": { "after_min": 100, "before_min": 140 } },
      { "reply_regex": "(?i)(ping|remind|nudge|buzz) you" }
    ]
  }
}
