{
  "name": "whats_on_today_empty",
  "why": "Every listed day-tool called; a real empty day is a hole — ask what goes on it. Never a bare 'nothing today'.",
  "inbound": "what's on today?",
  "memory": [
    { "kind": "insight", "subject": "aim/training", "content": "3x gym this month" },
    { "kind": "preference", "subject": "pref/hours", "content": "sleep: 23:00-06:00\nwork: 07:00-15:00" },
    { "kind": "preference", "subject": "pref/food", "content": "loves Thai, not sushi" }
  ],
  "force": ["google"],
  "tools": [
    {
      "name": "google__calendar_list_events",
      "description": "List calendar events for a day. Args: date (YYYY-MM-DD, default today).",
      "params": { "type": "object", "properties": { "date": { "type": "string", "description": "YYYY-MM-DD; default today" } } },
      "result": "[]"
    },
    {
      "name": "google__calendar_create_events",
      "description": "Create one or many events in one call. Required: events[{summary, start_time, end_time}]. A single event is a one-element list.",
      "params": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "description": "One element for a single event.",
            "items": {
              "type": "object",
              "properties": {
                "summary": { "type": "string" },
                "start_time": { "type": "string", "description": "RFC3339" },
                "end_time": { "type": "string", "description": "RFC3339" }
              },
              "required": ["summary", "start_time", "end_time"]
            }
          }
        },
        "required": ["events"]
      },
      "result": "{\"id\":\"evt_1\",\"status\":\"confirmed\"}"
    }
  ],
  "expect": {
    "round_budget": 2,
    "tools_called": [{ "name": "google__calendar_list_events" }],
    "reply_regex": "\\?",
    "silent": false,
    "wait": true
  }
}
