{
  "name": "chat_todo_add",
  "why": "They name something they have to do. The agent keeps the pocket list: one memory_store fact todo/<slug> in their words, a short line back, no question.",
  "inbound": "ugh I need to call the dentist this week and book a cleaning",
  "memory": [
    { "kind": "insight", "subject": "aim/training", "content": "3x gym this month" }
  ],
  "expect": {
    "round_budget": 2,
    "tools_called": [
      {
        "name": "memory_store",
        "args_regex": "\"subject\"\\s*:\\s*\"todo/[a-z0-9][a-z0-9_-]*\"",
        "max_calls": 1
      },
      {
        "name": "memory_store",
        "args_regex": "(?i)\"content\"\\s*:\\s*\"[^\"]*dentist"
      }
    ],
    "tools_not_called": ["memory_recall", "aim_log", "cron_schedule"],
    "wait": false,
    "reply_not_regex": "(?i)\\?|todo/|memory_store"
  }
}
